<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permissions, and why each one is here (SPEC.md 6.4).

      READ_MEDIA_* / READ_EXTERNAL_STORAGE: to list the photos and videos in
      the system trash and the media caches this app can recover from. The
      trash is restored through MediaStore.createTrashRequest, which always
      shows the system's own confirmation dialog: this app cannot untrash
      anything without the person tapping Allow.

      INTERNET: the only socket this app opens is to 127.0.0.1, carried to the
      computer over the USB cable by `adb reverse`. Android requires this
      permission even for a loopback socket. There is no analytics, no ads, no
      update check, and no other host is ever contacted; BridgeClient refuses
      any address that is not loopback.

      Deliberately NOT requested: MANAGE_EXTERNAL_STORAGE (all-files access),
      ACCESS_NETWORK_STATE, FOREGROUND_SERVICE, RECEIVE_BOOT_COMPLETED,
      QUERY_ALL_PACKAGES. This app has no background component: it does
      nothing unless it is open on the screen.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
